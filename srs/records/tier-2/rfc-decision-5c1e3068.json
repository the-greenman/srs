  "fieldValues": [
    {
      "fieldId": "1a000001-0000-4000-a000-000000000001",
      "value": "Put a deterministic target-neutral IR between records and emitters"
    },
    {
      "fieldId": "5a000002-0000-4000-a000-000000000002",
      "value": "accepted"
    },
    {
      "fieldId": "5a000004-0000-4000-a000-000000000004",
      "value": "2026-07-29"
    },
    {
      "fieldId": "5a000012-0000-4000-a000-000000000012",
      "value": "Semantic interpretation must be shared before targets render it. A deterministic neutral intermediate representation prevents each backend from inventing incompatible meanings while preserving target-specific output mechanics."
    },
    {
      "fieldId": "5a000019-0000-4000-a000-000000000019",
      "value": "Projection resolves semantic meaning into a target-neutral intermediate representation before any target back end renders it."
    },
    {
      "fieldId": "5a000020-0000-4000-a000-000000000020",
      "value": "Schema projection architecture"
    },
    {
      "fieldId": "5a000021-0000-4000-a000-000000000021",
      "value": [
        "semantic-integrity",
        "shared-coherence"
      ]
    },
    {
      "fieldId": "5a000022-0000-4000-a000-000000000022",
      "value": "formation"
    },
    {
      "fieldId": "5a000023-0000-4000-a000-000000000023",
      "value": "- Let each target define an independent semantic interpretation."
    },
    {
      "fieldId": "5a000024-0000-4000-a000-000000000024",
      "value": "All emitters depend on a shared interpretation layer whose changes affect every target."
    },
    {
      "fieldId": "5a000025-0000-4000-a000-000000000025",
      "value": [
