{
  "$schema": "https://srs.semanticops.com/schema/2.0/record.json",
  "createdAt": "2026-08-02T13:59:15.743643894+00:00",
  "fieldValues": [
    {
      "fieldId": "1a000001-0000-4000-a000-000000000001",
      "value": "Keep presentation hints outside the semantic type model"
    },
    {
      "fieldId": "5a000002-0000-4000-a000-000000000002",
      "value": "accepted"
    },
    {
      "fieldId": "5a000004-0000-4000-a000-000000000004",
      "value": "2026-07-29"
    },
    {
      "fieldId": "5a000012-0000-4000-a000-000000000012",
      "value": "Input and display choices describe how a consumer presents meaning, not what the Field means. Keeping them outside fieldType preserves concurrent legitimate views while requiring rendering to own its own portable contract."
    },
    {
      "fieldId": "5a000019-0000-4000-a000-000000000019",
      "value": "Editor and composite-renderer hints remain presentation-layer concerns and are not encoded as fieldType facets."
    },
    {
      "fieldId": "5a000020-0000-4000-a000-000000000020",
      "value": "Semantic model and rendering boundary"
    },
    {
      "fieldId": "5a000021-0000-4000-a000-000000000021",
      "value": [
        "semantic-integrity",
        "local-autonomy"
      ]
    },
    {
      "fieldId": "5a000022-0000-4000-a000-000000000022",
      "value": "formation"
    },
    {
      "fieldId": "5a000023-0000-4000-a000-000000000023",
      "value": "- Treat input widgets and composite renderers as semantic type facets."
    },
    {
      "fieldId": "5a000024-0000-4000-a000-000000000024",
      "value": "Presentation behavior needs a separate view-layer contract and cannot be recovered from Field meaning alone."
    },
    {
      "fieldId": "5a000025-0000-4000-a000-000000000025",
      "value": [
        "https://github.com/the-greenman/srs/blob/de2310bc5d90ed47597c0a1a99beffa26ac396b1/rfcs/rfc-032-composite-field-range.md#rationale",
        "https://github.com/the-greenman/srs/blob/ae52927de4e45490cb427fee2b332d5351f536cd/docs/schema/2.0/field.json"
      ]
    },
    {
      "fieldId": "5a000026-0000-4000-a000-000000000026",
      "value": "Review when a proposed view capability appears to change interoperability or validation rather than presentation alone."
    }
  ],
  "instanceId": "6523cf5e-959b-40e1-91d0-ca2f4c0834be",
