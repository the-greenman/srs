// Host-binding config for srs.semanticops.com: it says where the rendered docs/ directory is
// served from. It is the same class of file as CNAME and carries no spec content.
// An assets-only Worker (no `main`): Cloudflare Workers static assets serve ./docs as plain files.
// Serves srs.semanticops.com through a route over the existing proxied DNS record (cutover, srs#897).
// Deploys run through Workers Builds on master; rollback is deleting the route. See docs/HOSTING.md.
{
  "name": "srs-semanticops-com",
  "compatibility_date": "2026-10-05",
  "workers_dev": false,
  "routes": [{ "pattern": "srs.semanticops.com/*", "zone_name": "semanticops.com" }],
  "assets": {
    "directory": "./docs",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Required by `wrangler preview`, which Workers Builds runs for non-production branches. Empty:
  // assets, routes and compatibility settings stay at the top level.
  "previews": {}
}
