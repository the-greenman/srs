{
  "$comment": "RFC-051 (per-entry container storage, dataModelRevision 11) conformance scenarios, run against the pinned srs CLI by tests/arrangement-storage/run.mjs (srs#949). Each scenario works on a fresh copy of fixture-repo. Ids are written $NAME and resolved from `ids`; the record ids are the fixture's, whose byte order is ZETA < EPS < GAMMA < ETA < BETA < DELTA < ALPHA. `case` names the RFC-051 conformance fixture case the scenario covers. Expectations were captured from v0.1.0-build.554 and checked against the rule each cites.",
  "ids": {
    "C": "0a0000c5-0000-4000-8000-000000000001",
    "OUTLINE": "0a0000c1-0000-4000-8000-000000000001",
    "GONE": "0a0000ff-0000-4000-8000-000000000099",
    "ZETA": "21dbfbfa-dd9e-47a8-b785-a00bac9497ae",
    "EPS": "291abed5-1baa-429f-948e-3cb4bf267c07",
    "GAMMA": "3c8311aa-410e-4052-be62-dba11656a94b",
    "ETA": "64514d71-a09c-4a1a-90a3-97c4da7f2b55",
    "BETA": "8eef4acf-ac8f-4496-902a-5d06e034fc46",
    "DELTA": "c15b3417-3578-416a-bc50-8c1a2e16eb47",
    "ALPHA": "dc328f4b-cd1d-40f7-92ec-0c36b69894bc"
  },
  "scenarios": [
    {
      "name": "migration_is_deterministic",
      "rules": [
        "R13"
      ],
      "case": "deterministic migration",
      "description": "The fixture's containers, turned back into revision-10 flat files with their logical outlines, migrate to exactly the committed directories (keys are successive appends among siblings, parents from RFC-043 [R5]); a second run reports alreadyApplied.",
      "given": {
        "flatten": true
      },
      "steps": [
        {
          "cli": [
            "repo",
            "apply-migration",
            "--id",
            "rfc051-container-entries"
          ],
          "expect": {
            "payload.payload.toRevision": 11,
            "payload.payload.alreadyApplied": false
          }
        },
        {
          "cli": [
            "repo",
            "apply-migration",
            "--id",
            "rfc051-container-entries"
          ],
          "expect": {
            "payload.payload.alreadyApplied": true
          }
        }
      ],
      "expect": {
        "fixtureBytes": true
      }
    },
    {
      "name": "appends_write_one_entry_each_never_the_head",
      "rules": [
        "R1",
        "R3",
        "R8",
        "R9"
      ],
      "case": "key vectors",
      "description": "Each append writes one one-line entry and never the head: between nothing and nothing is a0, after a0 is a1.",
      "given": {
        "files": {
          "containers/$C/container.json": {
            "containerId": "$C",
            "title": "Storage"
          }
        }
      },
      "steps": [
        {
          "cli": [
            "container",
            "members",
            "add",
            "$C",
            "$ALPHA"
          ]
        },
        {
          "cli": [
            "container",
            "members",
            "add",
            "$C",
            "$BETA"
          ]
        }
      ],
      "expect": {
        "writes": {
          "containers/$C/entries/$ALPHA.json": {
            "containerId": "$C",
            "instanceId": "$ALPHA",
            "key": "a0"
          },
          "containers/$C/entries/$BETA.json": {
            "containerId": "$C",
            "instanceId": "$BETA",
            "key": "a1"
          }
        },
        "outline": {
          "$C": [
            {
              "instanceId": "$ALPHA"
            },
            {
              "instanceId": "$BETA"
            }
          ]
        }
      }
    },
    {
      "name": "key_after_az_is_b00",
      "rules": [
        "R4",
        "R9"
      ],
      "case": "key vectors",
      "description": "Appendix key vector: after az is b00.",
