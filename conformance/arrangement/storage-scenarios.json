            {
              "instanceId": "$ETA",
              "depth": 1
            }
          ]
        }
      }
    },
    {
      "name": "dangling_pointer_is_a_validation_error",
      "rules": [
        "R14"
      ],
      "case": "a dangling pointer",
      "description": "The head's anchorInstanceId names GAMMA, which is no entry: RFC-043 [R3]'s validation error, container-pointer-unresolved, not fatal.",
      "given": {
        "files": {
          "containers/$C/container.json": {
            "containerId": "$C",
            "title": "Storage",
            "anchorInstanceId": "$GAMMA"
          },
          "containers/$C/entries/$ALPHA.json": {
            "containerId": "$C",
            "instanceId": "$ALPHA",
            "key": "a0"
          }
        }
      },
      "expect": {
        "diagnostics": [
          {
            "code": "container-pointer-unresolved",
            "severity": "error"
          }
        ]
      }
    },
    {
      "name": "head_versus_entry_classification",
      "rules": [
        "R12",
        "R14"
      ],
      "case": "head versus entry classification",
      "description": "A file under entries/ that carries a title and no key is not an entry: container-schema, fatal.",
      "given": {
        "files": {
          "containers/$C/container.json": {
            "containerId": "$C",
            "title": "Storage"
          },
          "containers/$C/entries/$ALPHA.json": {
            "containerId": "$C",
            "instanceId": "$ALPHA",
            "title": "Not an entry"
          }
        }
      },
      "expect": {
        "fatal": "container-schema"
      }
    },
    {
      "name": "head_carrying_members_refused",
      "rules": [
        "R1",
        "R14"
      ],
      "case": "head versus entry classification",
      "description": "A head that carries memberInstanceIds is container-schema, fatal.",
      "given": {
        "files": {
          "containers/$C/container.json": {
            "containerId": "$C",
            "title": "Storage",
            "memberInstanceIds": []
          }
        }
      },
      "expect": {
        "fatal": "container-schema"
      }
    },
    {
      "name": "stray_file_refused",
      "rules": [
        "R1",
        "R14"
      ],
      "case": "a stray file",
      "description": "Any file other than container.json and entries/<instanceId>.json in a container directory is container-stray-file, fatal.",
      "given": {
        "files": {
          "containers/$C/container.json": {
            "containerId": "$C",
            "title": "Storage"
          },
          "containers/$C/entries/$ALPHA.json": {
            "containerId": "$C",
            "instanceId": "$ALPHA",
            "key": "a0"
          },
          "containers/$C/notes.json": {}
        }
      },
      "expect": {
        "fatal": "container-stray-file"
      }
    },
    {
      "name": "entry_misplaced_refused",
      "rules": [
        "R2",
        "R14"
      ],
      "case": "a stray file",
      "description": "An entry whose containerId differs from its directory is container-entry-misplaced, fatal.",
      "given": {
        "files": {
          "containers/$C/container.json": {
            "containerId": "$C",
            "title": "Storage"
          },
          "containers/$C/entries/$ALPHA.json": {
            "containerId": "$OUTLINE",
            "instanceId": "$ALPHA",
            "key": "a0"
          }
        }
      },
      "expect": {
        "fatal": "container-entry-misplaced"
      }
    },
    {
      "name": "entry_name_mismatch_refused",
      "rules": [
        "R2",
        "R14"
      ],
      "case": "a stray file",
      "description": "An entry file whose name differs from its instanceId is container-name-mismatch, fatal.",
      "given": {
        "files": {
          "containers/$C/container.json": {
            "containerId": "$C",
            "title": "Storage"
          },
          "containers/$C/entries/$BETA.json": {
            "containerId": "$C",
            "instanceId": "$ALPHA",
            "key": "a0"
          }
        }
      },
      "expect": {
        "fatal": "container-name-mismatch"
      }
    },
    {
      "name": "concurrent_appends_with_equal_keys_merge_cleanly",
      "rules": [
        "R9",
        "R10",
        "R5"
      ],
      "case": "concurrent appends with equal keys",
      "description": "Two branches each append to the empty container; both entries get key a0, plain git merges cleanly, and the instanceId tie-break orders them (BETA before ALPHA).",
      "given": {
        "files": {
          "containers/$C/container.json": {
            "containerId": "$C",
            "title": "Storage"
          }
        }
      },
      "git": {
        "branches": {
          "one": [
            {
              "cli": [
                "container",
                "members",
                "add",
                "$C",
                "$ALPHA"
              ]
            }
          ],
          "two": [
            {
              "cli": [
                "container",
                "members",
                "add",
                "$C",
                "$BETA"
              ]
            }
          ]
        },
        "merge": [
          "one",
          "two"
        ]
      },
      "expect": {
        "merge": "clean",
        "outline": {
          "$C": [
            {
              "instanceId": "$BETA"
            },
            {
              "instanceId": "$ALPHA"
            }
          ]
        }
      }
    },
    {
      "name": "add_add_equal_merges_cleanly",
      "rules": [
        "R10"
      ],
      "case": "add/add, with equal and with different values",
      "description": "Both branches append ALPHA to the empty container: the same path with the same bytes on both sides keeps that change.",
      "given": {
        "files": {
          "containers/$C/container.json": {
            "containerId": "$C",
            "title": "Storage"
          }
        }
      },
      "git": {
        "branches": {
          "one": [
            {
              "cli": [
                "container",
                "members",
                "add",
                "$C",
                "$ALPHA"
              ]
            }
          ],
          "two": [
            {
              "cli": [
                "container",
                "members",
                "add",
                "$C",
                "$ALPHA"
              ]
            }
          ]
        },
        "merge": [
          "one",
          "two"
        ]
      },
      "expect": {
        "merge": "clean",
        "outline": {
          "$C": [
            {
              "instanceId": "$ALPHA"
            }
          ]
        }
      }
    },
    {
      "name": "add_add_different_conflicts",
      "rules": [
        "R10"
      ],
      "case": "add/add, with equal and with different values",
      "description": "One branch appends ALPHA (a0); the other appends BETA and then inserts ALPHA first (Zz). The same path with different bytes is a conflict.",
      "given": {
        "files": {
          "containers/$C/container.json": {
            "containerId": "$C",
            "title": "Storage"
          }
        }
      },
      "git": {
        "branches": {
          "one": [
            {
              "cli": [
                "container",
                "members",
                "add",
                "$C",
                "$ALPHA"
              ]
            }
          ],
          "two": [
            {
              "cli": [
                "container",
                "members",
                "add",
                "$C",
                "$BETA"
              ]
            },
            {
              "cli": [
                "container",
                "members",
                "add",
                "$C",
                "$ALPHA",
                "--position",
                "0"
              ]
            }
          ]
        },
        "merge": [
          "one",
          "two"
        ]
      },
      "expect": {
        "merge": "conflict"
      }
    },
    {
      "name": "container_deleted_against_an_added_entry",
      "rules": [
        "R10",
        "R11",
        "R14"
      ],
      "case": "a container deleted against an added entry",
      "description": "One branch deletes the container (its head and ALPHA's entry); the other appends BETA. The merge is clean and leaves a directory with BETA's entry and no head: container-head-missing, a warning, ignored; repair removes the directory.",
      "given": {
        "files": {
          "containers/$C/container.json": {
            "containerId": "$C",
            "title": "Storage"
          },
          "containers/$C/entries/$ALPHA.json": {
            "containerId": "$C",
            "instanceId": "$ALPHA",
            "key": "a0"
          }
        }
      },
      "git": {
        "branches": {
          "one": [
            {
              "cli": [
                "container",
                "delete",
                "$C"
              ]
            }
          ],
          "two": [
            {
              "cli": [
                "container",
                "members",
                "add",
                "$C",
                "$BETA"
              ]
            }
          ]
        },
        "merge": [
          "one",
          "two"
        ]
      },
      "steps": [
        {
          "cli": [
            "container",
            "members",
            "repair",
            "$C"
          ]
        }
      ],
      "expect": {
        "merge": "clean",
        "writes": {
          "containers/$C/entries/$BETA.json": null
        }
      }
    },
    {
      "name": "headless_directory_is_a_warning",
      "rules": [
        "R14"
      ],
      "case": "a container deleted against an added entry",
      "description": "Entries with no head: container-head-missing, a warning; the directory is ignored and the catalog loads.",
      "given": {
        "files": {
          "containers/$C/entries/$BETA.json": {
            "containerId": "$C",
            "instanceId": "$BETA",
            "key": "a1"
          }
        }
      },
      "expect": {
        "diagnostics": [
          {
            "code": "container-head-missing",
            "severity": "warning"
          }
        ]
      }
    },
    {
      "name": "rename_pairing_is_a_visible_conflict",
      "rules": [
        "R3",
        "R10"
      ],
      "case": "rename pairing",
      "description": "One branch removes ALPHA and appends GAMMA (a similar one-line file); the other moves ALPHA after BETA. With one-line files git never pairs them as a rename that would land the move on GAMMA: the delete against the modify is a visible conflict.",
      "given": {
        "files": {
          "containers/$C/container.json": {
            "containerId": "$C",
            "title": "Storage"
          },
          "containers/$C/entries/$ALPHA.json": {
            "containerId": "$C",
            "instanceId": "$ALPHA",
            "key": "a0"
          },
          "containers/$C/entries/$BETA.json": {
            "containerId": "$C",
            "instanceId": "$BETA",
            "key": "a1"
          }
        }
      },
      "git": {
        "branches": {
          "one": [
            {
              "cli": [
                "container",
                "members",
                "remove",
                "$C",
                "$ALPHA"
              ]
            },
            {
              "cli": [
                "container",
                "members",
                "add",
                "$C",
                "$GAMMA"
              ]
            }
          ],
          "two": [
            {
              "cli": [
                "container",
                "members",
                "move",
                "$C",
                "$ALPHA",
                "--position",
                "1"
              ]
            }
          ]
        },
        "merge": [
          "one",
          "two"
        ]
      },
      "expect": {
        "merge": "conflict"
      }
    },
    {
      "name": "rename_delete",
      "rules": [
        "R10"
      ],
      "case": "rename/delete and rename/rename",
      "description": "One branch removes ALPHA and appends GAMMA; the other removes ALPHA. Per path this is clean (ALPHA removed on both sides, GAMMA added on one); git MAY report a conflict, but a clean result MUST be BETA, GAMMA.",
      "given": {
        "files": {
          "containers/$C/container.json": {
            "containerId": "$C",
            "title": "Storage"
          },
          "containers/$C/entries/$ALPHA.json": {
            "containerId": "$C",
            "instanceId": "$ALPHA",
            "key": "a0"
          },
          "containers/$C/entries/$BETA.json": {
            "containerId": "$C",
            "instanceId": "$BETA",
            "key": "a1"
          }
        }
      },
      "git": {
        "branches": {
          "one": [
            {
              "cli": [
                "container",
                "members",
                "remove",
                "$C",
                "$ALPHA"
              ]
            },
            {
              "cli": [
                "container",
                "members",
                "add",
                "$C",
                "$GAMMA"
              ]
            }
          ],
          "two": [
            {
              "cli": [
                "container",
                "members",
                "remove",
                "$C",
                "$ALPHA"
              ]
            }
          ]
        },
        "merge": [
          "one",
          "two"
        ]
      },
      "expect": {
        "merge": "clean-or-conflict",
        "outline": {
          "$C": [
            {
              "instanceId": "$BETA"
            },
            {
              "instanceId": "$GAMMA"
            }
          ]
        }
      }
    },
    {
      "name": "rename_rename",
      "rules": [
        "R10"
      ],
      "case": "rename/delete and rename/rename",
      "description": "One branch removes ALPHA and appends GAMMA; the other removes ALPHA and appends DELTA. Per path this is clean; git MAY report a conflict, but a clean result MUST be BETA, GAMMA, DELTA (equal keys a2, by instanceId).",
      "given": {
        "files": {
          "containers/$C/container.json": {
            "containerId": "$C",
            "title": "Storage"
          },
          "containers/$C/entries/$ALPHA.json": {
            "containerId": "$C",
            "instanceId": "$ALPHA",
            "key": "a0"
          },
          "containers/$C/entries/$BETA.json": {
            "containerId": "$C",
            "instanceId": "$BETA",
            "key": "a1"
          }
        }
      },
      "git": {
        "branches": {
          "one": [
            {
              "cli": [
                "container",
                "members",
                "remove",
                "$C",
                "$ALPHA"
              ]
            },
            {
              "cli": [
                "container",
                "members",
                "add",
                "$C",
                "$GAMMA"
              ]
            }
          ],
          "two": [
            {
              "cli": [
                "container",
                "members",
                "remove",
                "$C",
                "$ALPHA"
              ]
            },
            {
              "cli": [
                "container",
                "members",
                "add",
                "$C",
                "$DELTA"
              ]
            }
          ]
        },
        "merge": [
          "one",
          "two"
        ]
      },
      "expect": {
        "merge": "clean-or-conflict",
        "outline": {
          "$C": [
            {
              "instanceId": "$BETA"
            },
            {
              "instanceId": "$GAMMA"
            },
            {
              "instanceId": "$DELTA"
            }
          ]
        }
      }
    }
  ]
}
