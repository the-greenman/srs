    {
      "name": "detached_entries_followed_by_an_operation",
      "rules": [
        "R8",
        "R9",
        "R11"
      ],
      "case": "detached entries followed by an operation",
      "description": "Revision 15 (srs#954). t = ZETA (a0, top level); orphans b = EPS (a0) and o = GAMMA (a1), whose parent names no entry; decoded t, b, o. Inserting n = BETA at position 1, depth 0 first re-attaches b = a1 and o = a2, then keys n = a0V. Exactly b, o and n are written, never t or the head. The one-pass keys n = a1, b = a2, o = a3 do not conform.",
      "given": {
        "files": {
          "containers/$C/container.json": {
            "containerId": "$C",
            "title": "Storage"
          },
          "containers/$C/entries/$ZETA.json": {
            "containerId": "$C",
            "instanceId": "$ZETA",
            "key": "a0"
          },
          "containers/$C/entries/$EPS.json": {
            "containerId": "$C",
            "instanceId": "$EPS",
            "key": "a0",
            "parent": "$GONE"
          },
          "containers/$C/entries/$GAMMA.json": {
            "containerId": "$C",
            "instanceId": "$GAMMA",
            "key": "a1",
            "parent": "$GONE"
          }
        }
      },
      "steps": [
        {
          "cli": [
            "container",
            "members",
            "add",
            "$C",
            "$BETA",
            "--position",
            "1",
            "--depth",
            "0"
          ]
        }
      ],
      "expect": {
        "writes": {
          "containers/$C/entries/$EPS.json": {
            "containerId": "$C",
            "instanceId": "$EPS",
            "key": "a1"
          },
          "containers/$C/entries/$GAMMA.json": {
            "containerId": "$C",
            "instanceId": "$GAMMA",
            "key": "a2"
          },
          "containers/$C/entries/$BETA.json": {
            "containerId": "$C",
            "instanceId": "$BETA",
            "key": "a0V"
          }
        },
        "outline": {
          "$C": [
            {
              "instanceId": "$ZETA"
            },
            {
              "instanceId": "$BETA"
            },
            {
              "instanceId": "$EPS"
            },
            {
              "instanceId": "$GAMMA"
            }
          ]
        }
      }
    },
