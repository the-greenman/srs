    {
      "name": "write_set_tie_placed_by_instance_id",
      "rules": [
        "R9"
      ],
      "case": "write sets with tie runs",
      "description": "EPS, BETA and ALPHA share key a0 (ordered by instanceId). Inserting GAMMA between EPS and BETA: the tied key a0 already places GAMMA there by instanceId, so GAMMA takes a0 and nothing else is written.",
      "given": {
        "files": {
          "containers/$C/container.json": {
            "containerId": "$C",
            "title": "Storage"
          },
          "containers/$C/entries/$EPS.json": {
            "containerId": "$C",
            "instanceId": "$EPS",
            "key": "a0"
          },
          "containers/$C/entries/$BETA.json": {
            "containerId": "$C",
            "instanceId": "$BETA",
            "key": "a0"
          },
          "containers/$C/entries/$ALPHA.json": {
            "containerId": "$C",
            "instanceId": "$ALPHA",
            "key": "a0"
          }
        }
