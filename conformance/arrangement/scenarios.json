      "expectedCode": "arrangement-pointer"
    },
    {
      "name": "arranged_heading_levels_depth_zero_to_four",
      "rules": [
        "R9"
      ],
      "description": "Heading level is 3 + depthOffset + depth. The Mixed container nests an item to depth 4 (Alpha 1, Beta 2, Gamma 3, Theta 4); the records of another type render as properties, not headings. Depth 4 computes level 7 and is clamped to 6.",
      "operation": {
        "render": "composition",
        "view": "0a0000d1-0000-4000-8000-000000000001",
        "container": "0a0000c2-0000-4000-8000-000000000001",
        "format": "markdown"
      },
      "expectedHeadings": [
        {
          "level": 4,
          "title": "Alpha"
        },
        {
          "level": 5,
          "title": "Beta"
        },
        {
          "level": 6,
          "title": "Gamma"
        },
        {
          "level": 6,
          "title": "Theta"
        },
        {
          "level": 5,
          "title": "Delta"
        },
        {
          "level": 3,
          "title": "Epsilon"
        }
      ],
      "expectedDiagnosticContains": "computed heading level 7 exceeds 6"
    },
    {
      "name": "arranged_depth_offset_clamps_at_level_six",
      "rules": [
        "R9"
      ],
      "description": "A depthOffset of 3 moves the document title to level 4 and the section to level 5, so every entry of the depth-2 outline computes level 6 or more. The render does not fail: levels clamp to 6 and each clamp is a diagnostic.",
      "operation": {
        "render": "composition",
        "view": "0a0000d1-0000-4000-8000-000000000003",
        "container": "0a0000c1-0000-4000-8000-000000000001",
        "format": "markdown"
      },
      "expectedHeadings": [
