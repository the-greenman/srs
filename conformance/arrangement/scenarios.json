        {
          "level": 5,
          "title": "Section"
        },
        {
          "level": 6,
          "title": "Alpha"
        },
        {
          "level": 6,
          "title": "Beta"
        },
        {
          "level": 6,
          "title": "Gamma"
        },
        {
          "level": 6,
          "title": "Delta"
        },
        {
          "level": 6,
          "title": "Epsilon"
        },
        {
          "level": 6,
          "title": "Zeta"
        },
        {
          "level": 6,
          "title": "Eta"
        }
      ],
      "expectedDiagnosticContains": "clamped to 6"
    },
    {
      "name": "type_filter_promotes_descendants_of_an_excluded_entry",
      "rules": [
        "R7",
        "R9"
