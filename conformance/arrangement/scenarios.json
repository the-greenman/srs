        {
          "level": 5,
          "title": "Theta"
        },
        {
          "level": 3,
          "title": "Delta"
        },
        {
          "level": 3,
          "title": "Epsilon"
        }
      ]
    },
    {
      "name": "type_filter_excluding_the_anchor_renders_normally",
      "rules": [
        "R7"
