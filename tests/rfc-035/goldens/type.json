{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srs.semanticops.com/schema/2.0/type.json",
  "description": "A named, versioned composition of Fields. Extension-owned facets (lifecycle, inheritance, cross-field-validation) are modelled as separate Types extending this one via ext:type-inheritance (RFC-040 Change A); tags and identityFieldId are core Type surface.",
  "type": "object",
  "required": [
    "id",
    "namespace",
    "name",
    "version",
    "description",
    "fields",
    "createdAt"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "namespace": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "semanticObjectType": {
      "type": "string",
      "title": "Semantic Object Type"
    },
    "aiGuidance": {
      "$ref": "#/$defs/com.semanticops.srs__ai-guidance__v1",
      "title": "AI Guidance"
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/com.semanticops.srs__field-assignment__v1"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lineage": {
      "$ref": "#/$defs/com.semanticops.srs__lineage__v1"
    },
    "provenance": {
      "$ref": "#/$defs/com.semanticops.srs__provenance__v1"
    },
    "identityFieldId": {
      "type": "string",
      "format": "uuid",
      "title": "Identity Field Id"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "com.semanticops.srs__ai-guidance__v1": {
      "type": "object",
      "required": [
        "purpose"
      ],
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "type": "string"
        },
        "extraction": {
          "type": "string"
        },
        "negativeGuidance": {
          "type": "string",
          "title": "Negative Guidance"
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/com.semanticops.srs__ai-guidance-example__v1"
          }
        }
      }
    },
    "com.semanticops.srs__ai-guidance-example__v1": {
      "type": "object",
      "required": [
        "output"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "input": {
          "type": "string"
        },
        "output": {
          "type": "string"
        }
      }
    },
    "com.semanticops.srs__field-assignment__v1": {
      "type": "object",
      "required": [
        "fieldId",
        "order",
        "required"
      ],
      "additionalProperties": false,
      "properties": {
        "fieldId": {
          "type": "string",
          "format": "uuid",
          "x-srs-range-type": "com.semanticops.srs/field@1",
          "title": "Field"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "required": {
          "type": "boolean"
        },
        "displayLabel": {
          "type": "string",
          "title": "Display Label"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "com.semanticops.srs__lineage__v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceDefinitionId": {
          "type": "string",
          "format": "uuid",
          "title": "Source Definition Id"
        },
        "sourceVersion": {
          "type": "integer",
          "title": "Source Version"
        },
        "forkedFromDefinitionId": {
          "type": "string",
          "format": "uuid",
          "title": "Forked-From Definition Id"
        },
        "forkedFromVersion": {
          "type": "integer",
          "title": "Forked-From Version"
        }
      }
    },
    "com.semanticops.srs__provenance__v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publisher": {
          "type": "string"
        },
        "sourcePackage": {
          "type": "string",
          "title": "Source Package"
        },
        "packageVersion": {
          "type": "string",
          "title": "Package Version"
        },
        "importedAt": {
          "type": "string",
          "format": "date-time",
          "title": "Imported At"
        }
      }
    }
  }
}
